  "provenance": {
    "how": "Every field here was copied out of that run's own records, so a test can check a pin against the record rather than against the constant it is checking. The launch block is the exception and says so field by field below: no run directory writes down the command it was launched with, so those facts come from the shobench revision that run names, and the placeholders in the argv are this file's own. Every field is named, and the test beside this file fails on one that is not.",
    "run": "automationbench-claude_code-claude-opus-5-20260819T011123Z",
    "sources": {
      "dispensed_task_ids, outcome.sealed, outcome.finalize_error, outcome.mean_reward, outcome.successes": "rollout/results.jsonl, in order",
      "init": "rollout/traces/leg-0000.stream.jsonl, first line",
      "launch.argv, launch.mcp_config, launch.mcp_config_path, launch.environment": "src/shobench/harnesses/claude_code.py and src/shobench/harness.py at the shobench revision manifest names, which is where the argv and the environment a run directory does not keep were built",
      "launch.argv_placeholders": "the names this fixture writes into launch.argv where that launcher put a per-launch value, so a reader knows which tokens a test is meant to substitute. They are this file's own and no part of the record",
      "launch.cli_package, launch.cli_registry": "docker/agent.Dockerfile at that same revision. It installs the package by name and passes no registry, so the recorded run has a package to check against and no registry: a registry is this cell's own choice and is null here rather than invented",
      "launch.credential_names": "manifest.json, which records the credential mode this run ran under and, on its credential_mode axis, the name the environment carried. The spec that mode selects is in src/shobench/credentials.py at the shobench revision manifest names",
      "launch.mounts, launch.workdir": "src/shobench/containers.py and src/shobench/runner.py at that same revision",
      "outcome.dispensed, outcome.queued, outcome.stop_reason": "rollout_stopping.json",
      "outcome.legs, outcome.eval_after_legs, outcome.turns, outcome.wall_clock_s, outcome.returncode, outcome.terminal_reason": "legs.json",
      "run_id, started_at, started_at_utc, cell, container, harness, instruction, split.id_digest, split.seed, split.total_tasks, substrate.shogym_rev, substrate.shobench_rev, substrate.mcp_server_name, work, outcome.memory_files": "manifest.json",
      "split.heldout_task_ids, split.pool_task_ids": "splits/automationbench.json, the split manifest names",
      "substrate.automationbench_rev": "UPSTREAM_SHA in the automationbench adapter of the shogym revision manifest names"
    }
